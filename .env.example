# AFTERWEB Local Configuration
# All services run locally on loopback (127.0.0.1).

# API Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_PATH=data/local/afterweb.db

# Ollama Local LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=30.0

# Frontend & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Archive Client Bounds
ARCHIVE_REQUEST_TIMEOUT=15.0
ARCHIVE_MAX_RETRIES=2
